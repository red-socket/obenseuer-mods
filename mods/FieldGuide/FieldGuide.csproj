<Project Sdk="Microsoft.NET.Sdk">
  <!-- Framework, game references (incl. publicized Assembly-CSharp, firstpass with FullSerializer, UnityEngine.UI,
       TextMeshPro) come from ../../Directory.Build.props. -->
  <PropertyGroup>
    <AssemblyName>FieldGuide</AssemblyName>
    <RootNamespace>FieldGuide</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Test build only (spec §3, the Recipe Book / Message Log precedent): `dotnet build -c Release -p:FieldGuideTests=true`.
       Never package that build. -->
  <PropertyGroup Condition="'$(FieldGuideTests)' == 'true'">
    <DefineConstants>$(DefineConstants);FIELDGUIDE_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(FieldGuideTests)' != 'true'">
    <Compile Remove="Testing/**" />
  </ItemGroup>

  <!-- PhysicsModule: Collider, for the walk-in sauna triggers (H3, H4). -->
  <ItemGroup>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Trader data, generated by tools/gen_traders.py from the exported scenes (spec §8). -->
  <ItemGroup>
    <EmbeddedResource Include="Data/traders.json" LogicalName="FieldGuide.Data.traders.json" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="NEXUS.md;CHANGELOG.md;art/**;.internal/**;tools/**;Testing/**" />
  </ItemGroup>
</Project>
