<Project Sdk="Microsoft.NET.Sdk">
  <!-- Framework, game references (incl. publicized Assembly-CSharp, UnityEngine.UI, TextMeshPro) come from ../../Directory.Build.props. -->
  <PropertyGroup>
    <AssemblyName>SafeTravels</AssemblyName>
    <RootNamespace>SafeTravels</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Collider, Rigidbody and Physics (toll area bounds, unstuck clearance check, train triggers) are not in the shared references. -->
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="NEXUS.md;CHANGELOG.md;art/**;.internal/**" />
  </ItemGroup>
</Project>
